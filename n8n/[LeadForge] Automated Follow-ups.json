    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // 1. Safe extraction of messages and root labels\n  const messages = item.json.messages || [];\n  const rootLabels = item.json.labels || [];\n  \n  // 2. Check if root labels array contains 'INBOX'\n  // (Handles both array of strings and array of objects)\n  const hasInboxInRoot = rootLabels.some(l => {\n    if (typeof l === 'string') return l === 'INBOX';\n    if (l && typeof l === 'object') return l.id === 'INBOX';\n    return false;\n  });\n  \n  // 3. Check the very last message in the thread (The most accurate way)\n  let lastMessageIsInbox = false;\n  if (messages.length > 0) {\n    const lastMsg = messages[messages.length - 1];\n    \n    // Gmail API can return labels as 'labelIds' (strings) or 'labels' (objects)\n    const currentLabels = lastMsg.labelIds || lastMsg.labels || [];\n    \n    lastMessageIsInbox = currentLabels.some(l => {\n      if (typeof l === 'string') return l === 'INBOX';\n      if (l && typeof l === 'object') return l.id === 'INBOX';\n      return false;\n    });\n  }\n\n  // 4. Final Result: If either check is true, lead has replied\n  item.json.is_replied = hasInboxInRoot || lastMessageIsInbox;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
