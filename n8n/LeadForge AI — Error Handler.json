  "nodes": [
    {
      "parameters": {},
      "id": "b1ce14fb-eb85-413c-afc3-88d9c9cd58b2",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -624,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Extract Core Data\nconst err = items[0].json.execution;\nconst wf = items[0].json.workflow;\n\n// 2. Attempt to find the Lead's Email for context\nlet leadId = \"Unknown Prospect\";\ntry {\n  // Looks into the input data of the node that failed\n  leadId = err.error.context.item.json.email || err.error.context.item.json.contact_email || \"No Lead Info Found\";\n} catch (e) {}\n\n// 3. Rate Limiting Logic (Deduplication)\n// Prevents 100 alerts if a batch fails. Key = WorkflowName + NodeName\nconst errorKey = `err_${wf.id}_${err.lastNodeExecuted}`.replace(/\\s/g, '');\n\n// FIX: Added 'typeof' check to prevent \"is not defined\" error in Editor\nlet lastSent = 0;\nif (typeof $staticData !== 'undefined') {\n  lastSent = $staticData[errorKey] || 0;\n}\n\nconst now = Date.now();\nconst shouldNotify = (now - lastSent) > 900000; // 15 Minute Cooldown\n\nif (shouldNotify && typeof $staticData !== 'undefined') {\n  $staticData[errorKey] = now;\n}\n\nreturn {\n  workflow: wf.name,\n  node: err.lastNodeExecuted,\n  message: err.error.message,\n  url: err.url,\n  lead: leadId,\n  severity: [\"Send Email\", \"Sync Draft\"].includes(err.lastNodeExecuted) ? \"🔴 CRITICAL\" : \"⚠️ WARNING\",\n  should_notify: shouldNotify,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "c34a0311-1f60-4003-b628-f258e705efee",
      "name": "Analyze & Rate Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        160
      ],
      "retryOnFail": false
    },
